# Copy to .env and fill in. NEVER commit .env (gitignored).
# Cloud witnesses degrade gracefully — a missing/dead key = that witness reads "", the roster
# votes without it. Local models (setup.sh --models) need no keys at all.
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
HF_API_KEY=            # HuggingFace INFERENCE credits (hf witness); optional
HF_TOKEN=              # HuggingFace READ token (model downloads + pyannote gates)
NVIDIA_API_KEY=        # optional (NIM ASR experiments)
UMLS_API_KEY=          # medical domain terminology (optional outside medical work)
